{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clproxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "aa20d5af-1122-4960-8ca9-878a84f0b687","database_name": "clproxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "71adf253feec4a498ac71bbe0a0c3801" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
